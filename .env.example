# TelecomSafe API keys — template.
# Copy to .env (already done for you locally) and fill in the values there.
# .env is in .gitignore: never commit real keys.

# ---- Kaggle -----------------------------------------------------------------
# kaggle.com → Settings → API → "Generate New Token", paste the token here:
KAGGLE_API_TOKEN=
# Older "legacy" keys (kaggle.json) also work — fill these two instead of the token:
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Roboflow ---------------------------------------------------------------
# app.roboflow.com → Settings → API Keys → Private API Key
ROBOFLOW_API_KEY=

# ---- Label Studio (local annotation of TelecomEval) -------------------------
# Account created on first start by `python -m telecomsafe.data.labelstudio serve`.
# Pick any e-mail/password; the token is any 40-character hex string (one is generated for you in .env).
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_USERNAME=
LABEL_STUDIO_PASSWORD=
LABEL_STUDIO_TOKEN=

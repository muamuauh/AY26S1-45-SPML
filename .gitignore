# OS
Thumbs.db
.DS_Store
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data & model artefacts (do not commit)
# Nothing under data/ is tracked (the dataset catalogue lives in docs/datasets/).
# otherwise git cannot re-include the README.
data/*
*.pt
*.pth
*.safetensors
*.ckpt
runs/
wandb/
mlruns/
# Private dataset archives (APD: internal use only). download_datasets.* looks for them in the
# repository root, so never let git pick them up.
*.zip

# Teammates' TelecomEval submissions, unpacked locally (merged into data/raw/telecom_eval/)
temp_package/

# Secrets
.env

# Release / sharing staging (upload manually, never commit)
dist/
